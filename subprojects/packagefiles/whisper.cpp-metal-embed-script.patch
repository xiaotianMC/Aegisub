+            "sed -e '/#include \"common.h\"/d' -e '/#include \"dequantize.h\"/d' -e '/#include \"quantize.h\"/d' -e '/#include \"fa_common.metal\"/d' -e '/#include \"fa_vec_common.metal\"/d' -e '/#pragma once/d' < '${EMBED}.tmp1' > '${EMBED}.tmp2'\n"
